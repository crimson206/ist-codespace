{
  "name": "IST Workshop - Build a CLI with AI Agents",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/ist-codespace",
  "remoteUser": "node",

  // Everything heavy (claude-code, snapshot, `snapshot install @ist/beta`) is
  // baked into the image via the Dockerfile, so Codespaces Prebuild caches it
  // and re-opening is fast. postAttachCommand only prints the welcome/next-steps
  // banner — it must stay lightweight because it runs on every attach.
  "postAttachCommand": "bash .devcontainer/welcome.sh",

  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
