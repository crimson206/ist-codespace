{
  "name": "IST Monorepo Manager",
  "image": "crimson206/ist-base:latest",
  "workspaceFolder": "/workspaces/ist-codespace/examples/monorepo-manager",
  "postCreateCommand": "echo '✅ IST Monorepo environment ready! Read manager-prompt.md to coordinate multiple packages.' && ist-setup install --silent 2>/dev/null || true",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
      },
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "features": {},
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "forwardPorts": [3000, 4000, 5000]
}
